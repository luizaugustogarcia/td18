<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.unb.cic</groupId>
        <artifactId>td18</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>emitter</artifactId>

    <properties>
        <exec.mainClass>br.unb.cic.td18.WitnessEmitter</exec.mainClass>
        <td18.gpuDevices>0</td18.gpuDevices>
        <td18.gpuSlots>32</td18.gpuSlots>
        <td18.gpuBudgetMB>896</td18.gpuBudgetMB>
        <td18.gpuQueueCapacity></td18.gpuQueueCapacity>
        <td18.gpuStatsPeriodSeconds>10</td18.gpuStatsPeriodSeconds>
        <td18.cpuPrefixJvmArgument></td18.cpuPrefixJvmArgument>
        <td18.cpuPrefixMaxTriples>8192</td18.cpuPrefixMaxTriples>
        <td18.reconstructionCpuPrefixMillis>10</td18.reconstructionCpuPrefixMillis>
        <td18.reconstructionGpuMillis>0</td18.reconstructionGpuMillis>
        <td18.reconstructionGpuWorkers></td18.reconstructionGpuWorkers>
        <td18.cpuStatsPeriodSeconds>${td18.gpuStatsPeriodSeconds}</td18.cpuStatsPeriodSeconds>
        <td18.twistedBraceletWorkers>auto</td18.twistedBraceletWorkers>
        <td18.certificateDb>${project.basedir}/../certificates</td18.certificateDb>
        <td18.certificateFlushSeconds>5</td18.certificateFlushSeconds>
        <td18.certificateQueueCapacity>1048576</td18.certificateQueueCapacity>
        <td18.certificateLookupBatchSize>262144</td18.certificateLookupBatchSize>
        <td18.reconstructionBufferKeys>1048576</td18.reconstructionBufferKeys>
        <td18.args></td18.args>
    </properties>

    <dependencies>
        <dependency><groupId>org.rocksdb</groupId><artifactId>rocksdbjni</artifactId><classifier>linux64</classifier></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cpu-cli</id>
                        <goals><goal>java</goal></goals>
                    </execution>
                    <execution>
                        <id>default-cli</id>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <commandlineArgs>-classpath %classpath -Djava.library.path=${project.build.directory}/native -Dtd18.gpuDevices=${td18.gpuDevices} -Dtd18.gpuSlots=${td18.gpuSlots} -Dtd18.gpuBudgetMB=${td18.gpuBudgetMB} -Dtd18.gpuQueueCapacity=${td18.gpuQueueCapacity} -Dtd18.gpuStatsPeriodSeconds=${td18.gpuStatsPeriodSeconds} ${td18.cpuPrefixJvmArgument} -Dtd18.cpuPrefixMaxTriples=${td18.cpuPrefixMaxTriples} -Dtd18.reconstructionCpuPrefixMillis=${td18.reconstructionCpuPrefixMillis} -Dtd18.reconstructionGpuMillis=${td18.reconstructionGpuMillis} -Dtd18.reconstructionGpuWorkers=${td18.reconstructionGpuWorkers} -Dtd18.cpuStatsPeriodSeconds=${td18.cpuStatsPeriodSeconds} -Dtd18.twistedBraceletWorkers=${td18.twistedBraceletWorkers} -Dtd18.certificateDb=${td18.certificateDb} -Dtd18.certificateFlushSeconds=${td18.certificateFlushSeconds} -Dtd18.certificateQueueCapacity=${td18.certificateQueueCapacity} -Dtd18.dbWriteBatchEntries=${td18.dbWriteBatchEntries} -Dtd18.certificateLookupBatchSize=${td18.certificateLookupBatchSize} -Dtd18.reconstructionBufferKeys=${td18.reconstructionBufferKeys} ${exec.mainClass} ${td18.args}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.library.path=${project.build.directory}/native</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cpu-prefix-depth</id>
            <activation>
                <property><name>td18.cpuPrefixDepth</name></property>
            </activation>
            <properties>
                <td18.cpuPrefixJvmArgument>-Dtd18.cpuPrefixDepth=${td18.cpuPrefixDepth}</td18.cpuPrefixJvmArgument>
            </properties>
        </profile>
        <profile>
            <id>gpu</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>generate-sources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument><argument>src/native</argument>
                                        <argument>-B</argument><argument>${project.build.directory}/native</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>compile</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-ic</argument>
                                        <argument>cmake --build &quot;${project.build.directory}/native&quot; --parallel &quot;$(nproc)&quot;</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
