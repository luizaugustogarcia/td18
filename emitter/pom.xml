<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.unb.cic</groupId>
        <artifactId>td18</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>emitter</artifactId>

    <properties>
        <exec.mainClass>br.unb.cic.td18.WitnessEmitter</exec.mainClass>
        <td18.gpuDevices>0</td18.gpuDevices>
        <td18.gpuSlots>7</td18.gpuSlots>
        <td18.gpuBudgetMB>1024</td18.gpuBudgetMB>
        <td18.gpuQueueCapacity></td18.gpuQueueCapacity>
        <td18.gpuStatsPeriodSeconds>60</td18.gpuStatsPeriodSeconds>
        <td18.twistedBraceletWorkers>auto</td18.twistedBraceletWorkers>
        <td18.certificateDb>${project.basedir}/../certificates</td18.certificateDb>
        <td18.certificateFlushSeconds>5</td18.certificateFlushSeconds>
        <td18.args></td18.args>
    </properties>

    <dependencies>
        <dependency><groupId>org.rocksdb</groupId><artifactId>rocksdbjni</artifactId><version>10.4.2</version><classifier>linux64</classifier></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.13</version></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.13</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version></path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <commandlineArgs>-classpath %classpath -Djava.library.path=${project.build.directory}/native -Dtd18.gpuDevices=${td18.gpuDevices} -Dtd18.gpuSlots=${td18.gpuSlots} -Dtd18.gpuBudgetMB=${td18.gpuBudgetMB} -Dtd18.gpuQueueCapacity=${td18.gpuQueueCapacity} -Dtd18.gpuStatsPeriodSeconds=${td18.gpuStatsPeriodSeconds} -Dtd18.twistedBraceletWorkers=${td18.twistedBraceletWorkers} -Dtd18.certificateDb=${td18.certificateDb} -Dtd18.certificateFlushSeconds=${td18.certificateFlushSeconds} ${exec.mainClass} ${td18.args}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Djava.library.path=${project.build.directory}/native</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>gpu</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>generate-sources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument><argument>src/native</argument>
                                        <argument>-B</argument><argument>${project.build.directory}/native</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>compile</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-lc</argument>
                                        <argument>cmake --build &quot;${project.build.directory}/native&quot; --parallel &quot;$(nproc)&quot;</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
